#!/usr/bin/make -f

export CARGO_HOME = $(CURDIR)/debian/cargo_home
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	mkdir -p $(CARGO_HOME)
	sed -i 's/version = 4/version = 3/' Cargo.lock || true
	python3 -c 'import json, glob; [json.dump(dict(d, files={k: v for k, v in d.get("files", {}).items() if not k.endswith(".orig")}), open(p, "w")) for p in glob.glob("vendor/**/.cargo-checksum.json", recursive=True) for d in [json.load(open(p))]]' || true

override_dh_auto_build:
	cargo build --release --offline

override_dh_auto_test:
	cargo test --release --offline

override_dh_auto_install:
	install -D -m 0755 target/release/ruping $(CURDIR)/debian/ruping/usr/bin/ruping

override_dh_auto_clean:
	cargo clean || true
	rm -rf $(CARGO_HOME) target
	dh_auto_clean
